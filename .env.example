# Where the Progga Node API runs. The browser calls it directly.
# Production default (when unset): https://proggaapi.akxens.com
# Set this BEFORE `next build` - NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_BACKEND_URL=https://proggaapi.akxens.com

# Store pages for the mobile apps. Leave empty until published: the landing page shows "Coming soon".
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
